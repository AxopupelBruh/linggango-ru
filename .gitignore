# Ключи API — никогда не в репозиторий
*key*
# ...кроме словаря точечных правок по ключу (не секрет)
!key_overrides.json
*.env
*.pem

# Виртуальное окружение и кэш Python
venv/
__pycache__/
*.pyc

# Промежуточные артефакты сборки
pack_build/
plain/
backup/
*cache_*.json
*.bak
work/*.json.bak

# Системный мусор
.DS_Store
Thumbs.db
